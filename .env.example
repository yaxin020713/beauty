# ===== Notion API Configuration =====
# Get your API key from https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Database IDs from your Notion workspace
NOTION_PRODUCTS_DB_ID=your_products_database_id_here
NOTION_ORDERS_DB_ID=your_orders_database_id_here

# ===== Authentication Configuration =====
# This email will have admin privileges for product management
# Users: customers can login with any valid email, admins with this specific email
NEXT_PUBLIC_ADMIN_EMAIL=yaxinzhu2002@gmail.com

# ===== Bank Information (Optional - defaults provided) =====
# Used for checkout page to display payment details
NEXT_PUBLIC_BANK_CODE=822
NEXT_PUBLIC_BANK_ACCOUNT=1234-5678-9012
NEXT_PUBLIC_BANK_NAME=團購小幫手

# ===== API Configuration (for Server-Side Rendering) =====
# For local development, you can leave this empty or set to http://localhost:3000
# For production (Vercel), set this to your production URL
NEXT_PUBLIC_API_URL=http://localhost:3000
